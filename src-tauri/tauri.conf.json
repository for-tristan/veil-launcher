{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veil launcher",
  "version": "0.1.0",
  "identifier": "com.veil.launcher",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Veil launcher",
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": true,
        "resizable": true,
        "center": true,
        "backgroundColor": "#0a0b0d"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' https: data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' https: ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["msi", "nsis"],
    "resources": [
      "resources/mod-tools.exe",
      "resources/cslol_stub.c",
      "resources/cslol-dll.dll",
      "resources/patcher_host.exe",
      "resources/patcher_dll.dll"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "category": "Game",
    "shortDescription": "League of Legends skin changer",
    "longDescription": "Veil launcher is a fast, lightweight, minimalist skin changer for League of Legends. Browse, install, and manage community skin packs with a clean dark interface.",
    "copyright": "",
    "publisher": "Veil launcher"
  }
}
